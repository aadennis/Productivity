{
  "manifest_version": 3,
  "name": "Time Tracker",
  "version": "1.0",

  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://www.facebook.com/marketplace/*"
      ],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ]
}

